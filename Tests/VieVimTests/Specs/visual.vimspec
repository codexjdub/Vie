# Visual, Visual Line and Visual Block modes.

# charwise
"a|bcdef" → vlld → "a|ef"
"a|bcdef" → vllx → "a|ef"
"a|bc\ndef" → vjd → "a|f"
"a|bcdef" → vllcx<Esc> → "a|xef"
"a|bc def" → veU → "a|BC def"
"A|BC def" → veu → "A|bc def"
"a|bc" → v~ → "a|Bc"
"a|bcd" → vlrx → "a|xxd"
"a|bcdef" → vllohd → "|ef"
"a|bcdef" → vl<Esc>gvd → "a|def"
"a|bc d" → viwd → "| d"
"x (a|b) y" → vi(d → "x (|) y"
"x (a|b) y" → va(d → "x | y"
"foo |bar baz" → vawd → "foo |baz"
"a|bc\ndef" → vjyP → "a|bc\ndebc\ndef"
"a|bcdef" → v3ld → "a|f"
"abc d|ef" → vbd → "abc |f"
"a|bc" → v$d → "|a"
"a|bc\ndef" → vj$d → "|a"
"a|bc\ndef" → vjJ → "abc| def"
"a|bc\ndef" → vj> → "    |abc\n    def"
"a|bcdef" → vlly$p → "abcdefbc|d"

# linewise
"a|bc\ndef\nghi" → Vjd → "|ghi"
"abc\nd|ef\nghi" → Vkd → "|ghi"
"a|bc\ndef" → Vyp → "abc\n|abc\ndef"
"a|bc\ndef" → Vj> → "    |abc\n    def"
"a|bc\ndef\nghi" → VjJ → "abc| def\nghi"
"a|bc\ndef" → VU → "|ABC\ndef"
"a|bc\ndef" → Vjcx<Esc> → "|x"
"|ab\ncd" → yyjVp → "ab\n|ab"
"|ab" → ylvlp → "|a"

# block
"a|bcd\nefgh\nijkl" → <C-v>jld → "a|d\neh\nijkl"
"a|bcd\nefgh\nijkl" → <C-v>jjIx<Esc> → "a|xbcd\nexfgh\nixjkl"
"a|bcd\nefgh" → <C-v>jlAx<Esc> → "a|bcxd\nefgxh"
"a|bcd\nefgh" → <C-v>j$Ax<Esc> → "a|bcdx\nefghx"
"a|bcd\nefgh" → <C-v>jlrx → "a|xxd\nexxh"
"a|bcd\nefgh" → <C-v>jlcx<Esc> → "a|xd\nexh"
"a|bcd\nefgh" → <C-v>jl~ → "a|BCd\neFGh"
"a|b\nefgh" → <C-v>j$d → "|a\ne"
"a|bcd\nefgh" → <C-v>jlyP → "a|bcbcd\nefgfgh"
"a|bc\nd\nefg" → <C-v>jjld → "|a\nd\ne"
"a|bcd\nefgh" → <C-v>jlo<Esc>x → "a|cd\nefgh"
