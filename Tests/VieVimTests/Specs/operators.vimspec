# Operators with motions, doubled operators, and single-key changes.

# x X
"ab|cd" → x → "ab|d"
"abc|d" → x → "ab|c"
"ab|cd" → 5x → "a|b"
"ab|cdef" → 2x → "ab|ef"
"ab|cd" → X → "a|cd"
"|abcd" → X → "|abcd"
"abc|d" → 9X → "|d"
"日|本語" → x → "日|語"
"|" → x → "|"
"ab\n|\ncd" → x → "ab\n|\ncd"

# d with motions
"foo |bar baz" → dw → "foo |baz"
"foo b|ar baz" → dw → "foo b|baz"
"foo |bar" → dw → "foo| "
"foo |bar\nbaz" → dw → "foo| \nbaz"
"foo |bar baz qux" → 2dw → "foo |qux"
"foo |bar baz qux" → d2w → "foo |qux"
"foo |bar" → de → "foo| "
"foo b|ar" → db → "foo |ar"
"foo |bar" → d$ → "foo| "
"foo |bar" → D → "foo| "
"foo |bar\nbaz" → 2D → "foo| "
"foo |bar" → d0 → "|bar"
"  foo |bar" → d^ → "  |bar"
"a|bc\ndef\nghi" → dj → "|ghi"
"abc\nd|ef\nghi" → dk → "|ghi"
"abc\ndef\ng|hi" → dk → "|abc"
"|a,b,c" → df, → "|b,c"
"|a,b,c" → dt, → "|,b,c"
"a,b,|c" → dF, → "a,b|c"
"a,b,|c" → dT, → "a,b,|c"
"|(a b) c" → d% → "| c"
"a\nb|\n\nc" → d} → "a\n|\nc"
"a\nfoo |bar\n\nc" → d} → "a\nfoo| \n\nc"
"foo |bar baz" → dl → "foo |ar baz"
"foo |bar baz" → dh → "foo|bar baz"
"foo b|ar" → dge → "fo|r"
"foo |bar" → d3l → "foo| "

# dd and linewise motions
"abc\nd|ef\nghi" → dd → "abc\n|ghi"
"abc\ndef\ng|hi" → dd → "abc\n|def"
"|abc" → dd → "|"
"a|bc\ndef\nghi" → 2dd → "|ghi"
"a|bc\ndef" → 5dd → "|"
"a\n  b|c\nd" → dd → "a\n|d"
"abc\n  def\ng|hi" → dgg → "|"
"a|bc\ndef\nghi" → dG → "|"
"abc\nd|ef\nghi" → dG → "|abc"
"a\nb\nc|" → d2k → "|"
"a|bc\ndef\nghi\njkl" → d2j → "|jkl"

# c
"foo |bar baz" → cwx<Esc> → "foo |x baz"
"foo |bar baz" → cex<Esc> → "foo |x baz"
"foo |  bar" → cwx<Esc> → "foo |xbar"
"foo |bar baz qux" → c2wx<Esc> → "foo |x qux"
"foo |bar" → c$x<Esc> → "foo |x"
"foo |bar" → Cx<Esc> → "foo |x"
"  a|bc\ndef" → ccx<Esc> → "  |x\ndef"
"  a|bc\ndef" → Sx<Esc> → "  |x\ndef"
"a|bc" → sx<Esc> → "a|xc"
"a|bcd" → 2sx<Esc> → "a|xd"
"abc\nd|ef\nghi" → cjx<Esc> → "abc\n|x"
"foo(|a, b)" → ct)x<Esc> → "foo(|x)"
"foo |bar" → cw<Esc> → "foo| "
"a|bc\ndef" → 2ccx<Esc> → "|x"

# y, and the cursor after yanking
"foo |bar" → ywP → "foo ba|rbar"
"foo |bar" → yy → "foo |bar"
"a|bc\ndef" → yyp → "abc\n|abc\ndef"
"a|bc\ndef" → yyP → "|abc\nabc\ndef"
"a|bc\ndef" → yjP → "|abc\ndef\nabc\ndef"
"foo b|ar" → yiw → "foo |bar"
"foo b|ar" → yb → "foo |bar"
"a|bc\ndef" → Yp → "abc\n|abc\ndef"
"abc\nd|ef" → yk → "a|bc\ndef"
"a|bc\ndef" → y$$p → "abcb|c\ndef"

# J gJ
"a|bc\ndef" → J → "abc| def"
"a|bc\n   def" → J → "abc| def"
"a|bc\n)def" → J → "abc|)def"
"a|bc \ndef" → J → "abc |def"
"a|\nb\nc" → 3J → "a b| c"
"a|bc\ndef" → gJ → "abc|def"
"a|bc\n\ndef" → J → "ab|c\ndef"
"a|bc\n  def" → gJ → "abc|  def"
"a|bc" → J → "a|bc"

# ~ g~ gu gU
"|abc" → ~ → "A|bc"
"|abc" → 3~ → "AB|C"
"|Hello World" → g~w → "|hELLO World"
"|Hello World" → gUiw → "|HELLO World"
"|Hello World" → guu → "|hello world"
"Hello |World" → gUU → "|HELLO WORLD"
"|Hello World" → g~~ → "|hELLO wORLD"
"|éa" → ~ → "É|a"
"a|bc\ndef" → gUj → "A|BC\nDEF"
"Hello |World" → gu0 → "|hello World"

# > <
"a|bc\ndef" → >> → "    |abc\ndef"
"    a|bc" → << → "|abc"
"  a|bc" → << → "|abc"
"a|bc\ndef\nghi" → >j → "    |abc\n    def\nghi"
"a|bc\ndef" → 2>> → "    |abc\n    def"
"a|bc\n\ndef" → >G → "    |abc\n\n    def"
"        a|bc" → << → "    |abc"
"\ta|bc" → << → "|abc"

# r
"a|bc" → rx → "a|xc"
"a|bcd" → 3rx → "axx|x"
"a|bc" → 5rx → "a|bc"
"a|bc" → r<CR> → "a\n|c"
"a|bc" → r日 → "a|日c"

# counts multiply
"|a b c d e" → 2d2w → "|e"
"|aaa" → 2x → "|a"
