# Insert and Replace mode, dot repeat, undo.

# entering Insert mode
"a|bc" → ix<Esc> → "a|xbc"
"a|bc" → ax<Esc> → "ab|xc"
"  a|bc" → Ix<Esc> → "  |xabc"
"a|bc" → Ax<Esc> → "abc|x"
"  a|bc" → ox<Esc> → "  abc\n  |x"
"  a|bc" → Ox<Esc> → "  |x\n  abc"
"a|bc" → 3ix<Esc> → "axx|xbc"
"a|bc" → ixy<BS><Esc> → "a|xbc"
"a|bc" → ix<CR>y<Esc> → "ax\n|ybc"
"  a|bc" → A<CR>x<Esc> → "  abc\n  |x"
"a|bc" → 2ox<Esc> → "abc\nx\n|x"
"ab|c" → ix<C-w><Esc> → "a|bc"
"ab|c" → ix<C-u><Esc> → "a|bc"
"a|bc" → i<BS><BS><Esc> → "|bc"
"a|bc" → gIx<Esc> → "|xabc"
"  abc" → gIx<Esc> → "|x  abc"
"a|bc" → a<C-h>x<Esc> → "a|xc"
"a|bc" → i<Tab><Esc> → "a  | bc"
"a|bc" → A <Esc> → "abc| "
"{|" → A<CR>x<Esc> → "{\n|x"
"  abc|" → o<Esc> → "  abc\n|"

# Replace mode
"|abc" → Rxy<Esc> → "x|yc"
"|abc" → Rxyzw<Esc> → "xyz|w"
"|abc" → Rxy<BS><BS><Esc> → "|abc"
"|abc" → 2Rx<Esc> → "x|xc"

# dot repeat
"|a b c" → x. → "|b c"
"|a b c d" → dw. → "|c d"
"|a b c d" → dw2. → "|d"
"|a b c d" → 2dw. → "|"
"a|bc\nabc" → ix<Esc>j. → "axbc\na|xbc"
"|foo bar\nfoo bar" → cwx<Esc>j0. → "x bar\n|x bar"
"|a\nb\nc" → A;<Esc>j. → "a;\nb|;\nc"
"|a\nb\nc" → dd. → "|c"
"|a\nb" → >>j. → "    a\n    |b"
"|abc abc" → ~. → "AB|c abc"
"|x y" → ia<Esc>w. → "ax |ay"
"|a" → 3ix<Esc>. → "xxxx|xxa"
"|ab" → ax<Esc>. → "ax|xb"
"|a b" → cwx<Esc>w. → "x |x"
"|ab\ncd" → oz<Esc>j. → "ab\nz\ncd\n|z"
"|a,b,c" → f,r;;. → "a;b|;c"
"|abc" → ix<BS>y<Esc>. → "|yyabc"
"a|bcdef" → vld. → "a|f"
"|a\nb\nc\nd" → Vjd. → "|"
"|foo foo" → *Nciwx<Esc>n. → "x |x"

# undo and redo
"ab|cd" → xu → "ab|cd"
"ab|cd" → xxu → "ab|d"
"ab|cd" → xxuu → "ab|cd"
"ab|cd" → xu<C-r> → "ab|d"
"foo |bar baz" → dwu → "foo |bar baz"
"a|bc\ndef" → ddu → "|abc\ndef"
"|abc" → ixy<Esc>u → "|abc"
"|a b c" → dwdwuu<C-r> → "|b c"
"a|bc\ndef" → jddu → "abc\n|def"
"a|bc" → Ax<CR>y<Esc>u → "ab|c"
"abc |def" → cwx<Esc>u → "abc |def"
"|a\nb" → >>ju → "|a\nb"
