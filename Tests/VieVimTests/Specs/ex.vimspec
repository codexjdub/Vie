# Ex command line: :s with ranges and flags, line numbers.

"|a a\na" → :s/a/b/<CR> → "|b a\na"
"|a a\na" → :s/a/b/g<CR> → "|b b\na"
"|a a\na" → :%s/a/b/g<CR> → "b b\n|b"
"|a\na\na" → :2,3s/a/b/<CR> → "a\nb\n|b"
"|foo bar" → :s/\(foo\) \(bar\)/\2 \1/<CR> → "|bar foo"
"|foo" → :s/o/0/g<CR> → "|f00"
"|abc" → :s/b/\r/<CR> → "a\n|c"
"|a.b" → :s/./x/<CR> → "|x.b"
"|aaa" → :s/a/&&/<CR> → "|aaaa"
"|Foo foo" → :s/foo/bar/gi<CR> → "|bar bar"
"|a\nb\nc\nd" → :2<CR> → "a\n|b\nc\nd"
"|a\nb\nc" → :$<CR> → "a\nb\n|c"
"|a\nb\nc" → jVj:s/^/-/<CR> → "a\n-b\n|-c"
"|a\nb\nc\nd" → :.,+1s/$/!/<CR> → "a!\n|b!\nc\nd"
"|a\nb\nc" → :%s/b//<CR> → "a\n|\nc"
"|x" → :s/y/z/<CR> → "|x"
"|a/b" → :s#/#-#<CR> → "|a-b"
"|ab" → :s/b$/c/<CR> → "|ac"
"|aXb" → :s/x/-/i<CR> → "|a-b"
"  |a" → :s/a/b/<CR> → "  |b"
"|a\nb\nc" → :%s/^/> /<CR> → "> a\n> b\n|> c"
"|ab ab" → :s/ab/X/<CR>:s//Y/<CR> → "|X Y"
"|a\nb\nc" → :2,$s/./x/<CR> → "a\nx\n|x"
"|a\nb\nc\nd" → majjmb:'a,'bs/$/./<CR> → "a.\nb.\n|c.\nd"
"|foo" → :s/\<foo\>/bar/<CR> → "|bar"
"|path" → :s/path/a\/b/<CR> → "|a/b"
"|ab" → :s/\(a\)\(b\)/\=submatch(2)/<CR> → "|b"
"|a b" → :s/ /\t/<CR> → "|a\tb"
"|a\nb" → :%s/\n//<CR> → "|ab" → vie-only
"|abc" → :s/b\zsc/X/<CR> → "|abX"
