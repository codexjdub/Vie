# More commands: counts on ⌃A, put variants, ex line commands, Visual extras, search offsets.

# ⌃A ⌃X
"x |9 y" → <C-a> → "x 1|0 y"
"|x 9 y" → <C-a> → "x 1|0 y"
"x |-1 y" → <C-a> → "x |0 y"
"x |5" → 3<C-x> → "x |2"
"x |0x0f" → <C-a> → "x 0x1|0"
"|abc" → <C-a> → "|abc"
"a|1b2" → 5<C-a> → "a|6b2"

# gp gP
"|ab" → ylgp → "aa|b"
"|ab" → ylgP → "a|ab"
"|a\nb" → yygp → "a\na\n|b"
"|a\nb" → yygP → "a\n|a\nb"
"|ab" → yl2gp → "aaa|b"

# ex line commands
"|a\nb\nc" → :2d<CR> → "a\n|c"
"|a\nb\nc" → :d 2<CR> → "|c"
"|a\nb\nc" → :2,3y<CR>P → "|b\nc\na\nb\nc"
"|a\nb\nc" → :1m$<CR> → "b\nc\n|a"
"|a\nb\nc" → :3m0<CR> → "|c\na\nb"
"|a\nb\nc" → :1t.<CR> → "a\n|a\nb\nc"
"|a\nb\nc" → :1,2t$<CR> → "a\nb\nc\na\n|b"
"|a\nb\nc" → :1,3j<CR> → "|a b c"
"|a\nb\nc" → :j!<CR> → "|ab\nc"
"|a\nb" → :%><CR> → "    a\n    |b"
"|a" → :>><CR> → "        |a"
"|a\nb" → yy:2pu<CR> → "a\nb\n|a"
"|a\nb" → yy:1pu!<CR> → "|a\na\nb"
"|a\nb\nc" → :2<CR>dd → "a\n|c"
"|a\nb\nc" → :$-1<CR> → "a\n|b\nc"
"|a\nb\nc\nd" → :2;+1d<CR> → "a\n|d"
"|a\nb\nc" → :/c/d<CR> → "a\n|b"
"|ab\nab" → :%norm Ax<CR> → "abx\nab|x"
"|a\nb" → :%norm! I-<CR> → "-a\n|-b"
"|a\nb\nc" → :2,3norm dd<CR> → "|a"

# Visual extras
"a|bcd" → vlohd → "|d"
"a|bcd" → vl<Esc>0gvd → "a|d"
"a|bc\ndef\nghi" → VjJ → "abc| def\nghi"
"a|bc\ndef" → vjgJ → "abc|def"
"|ABC" → vlu → "|abC"
"|abc" → vlU → "|ABc"
"|a\nb" → Vj2> → "        |a\n        b"
"|ab\ncd" → <C-v>jo<Esc>x → "|b\ncd"
"a|b\ncd" → <C-v>jOd → "|a\nc"
"|a b" → vw~ → "|A B"
"|abc\ndef" → vjy`> → "abc\n|def"
"a|bc\ndef" → vjy`< → "a|bc\ndef"
"|abc" → v$y$p → "abcab|c"
"|a\nb\nc" → Vjyjp → "a\nb\n|a\nb\nc"
"a|bc" → vly`]x → "a|b"
"|abc def" → vee"_d → "|"

# search offsets and patterns
"|foo bar foo" → /foo/e<CR> → "fo|o bar foo"
"|foo bar\nfoo" → /bar/+1<CR> → "foo bar\n|foo"
"|foo bar foo" → /bar/s+1<CR> → "foo b|ar foo"
"|ab ab" → /b/e-1<CR> → "ab |ab"
"|foo.bar x foo.bar" → * → "foo.bar x |foo.bar"
"|a.b a.b" → g*N → "|a.b a.b"
"|foo\nbar\nfoo" → /foo<CR>N → "|foo\nbar\nfoo"
"|xaxbx" → /a\|b<CR>n → "xax|bx"
"|abc" → /\vb+<CR> → "a|bc"
"|a(b) a(b)" → /\V(b)<CR> → "a|(b) a(b)"
"|aXa aXa" → /X\zsa<CR> → "aX|a aXa"
"|foo bar" → /o\ze <CR> → "fo|o bar"
"|ab12" → /\d\+<CR>x → "ab|2"
"|foobar" → /\(foo\)\@<=bar<CR> → "foo|bar"
"|x foo foobar" → /foo\(bar\)\@!<CR> → "x |foo foobar"

# :s extras
"|hello world" → :s/\w\+/\u&/g<CR> → "|Hello World"
"|hello" → :s/hello/\U&/<CR> → "|HELLO"
"|Hello" → :s/\(H\)\(ello\)/\L\1\E\2/<CR> → "|hello"
"|a a" → :s/a/b/<CR>& → "|b b"
"|a a\na a" → :s/a/b/g<CR>j:&&<CR> → "b b\n|b b"
"|a a\na a" → :s/a/x/<CR>jg& → "x x\n|x a"
"|aaa" → :s/a/b/g3<CR> → "|bbb"
"|a\na\na" → :s/a/b/ 2<CR> → "b\n|b\na"
"|abc" → :s/b/[&]/<CR> → "|a[b]c"
"|abc" → :s/b/\&/<CR> → "|a&c"
"|a/b" → :s/\//-/<CR> → "|a-b"
"|aaa" → :s/a/x/n<CR> → "|aaa"
"|aaa" → :s/z/x/e<CR> → "|aaa"
"|a b" → :s/ /\r/<CR>u → "|a b"
"|ab" → :s/a/x/<CR>:s/b/~y/<CR> → "|xxy"

# insert extras
"a|bc" → i<C-r>.<Esc> → "|abc"
"|abc" → yiwA <C-r>"<Esc> → "abc ab|c"
"|abc" → A<C-v><Tab><Esc> → "abc|\t"
"|ab" → A<C-t><Esc> → "    a|b"
"    a|b" → A<C-d><Esc> → "a|b"
"ab|c" → i<Del><Esc> → "a|b"
"a|b\ncd" → A<Del><Esc> → "a|bcd"
"|abc" → Rx<CR>y<Esc> → "x\n|yc"
"a|bc" → ixyz<Left><Left>Q<Esc> → "ax|Qyzbc"
"|ab" → ix<Esc>u → "|ab"
"|ab" → A<CR><CR>x<Esc> → "ab\n\n|x"
"  |ab" → A<CR><CR>x<Esc> → "  ab\n\n  |x"
"|abc def" → wcwX<Esc>bgi!<Esc> → "abc X|!"

# marks and jumps
"|a\nb\nc" → jjmzgg'z → "a\nb\n|c"
"a|bc def" → wmxbd`x → "|def"
"|a\nb\nc" → jGx`' → "a\n|b\n"
"|a\nb" → jdd'. → "|a"
"|abc" → ix<Esc>0`^ → "x|abc"
"|a b c" → wmaw`a → "a |b c"
"|aa\nbb\ncc" → majmbjd'a → "|"

# macros
"|a1\na2" → qa0xjq@a → "1\n|2"
"|ab\nab\nab" → qbxjq2@b → "b\nb\n|b"
"|x\nx" → qqA!<Esc>jq:2norm @q<CR> → "x!\nx|!"
"|abc" → qaxqqAxq@a → "|"
"|a\nb\nc" → qaddq@a@: → "|c"

# counts and odds
"|a b c d e f" → 2d3w → "|"
"|abc" → 3. → "|abc"
"|a\nb\nc\nd" → dd2. → "|d"
"|aaaa" → x3. → "|"
"|abcdef" → 3x. → "|"
"|ab" → ylvp → "|ab"
"|abc" → vy"0p → "a|abc"
"|a\nb" → yyjVp"1p → "a\na\n|b"
