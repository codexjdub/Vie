# Search: / ? n N * # and patterns (Vim regex, translated for the regex engine).

"|foo bar foo" → /foo<CR> → "foo bar |foo"
"foo bar |foo" → /foo<CR> → "|foo bar foo"
"|foo bar foo" → /foo<CR>n → "|foo bar foo"
"foo bar fo|o" → ?foo<CR> → "foo bar |foo"
"|a foo b foo" → /foo<CR>N → "a foo b |foo"
"|a foo b foo" → ?foo<CR> → "a foo b |foo"
"|a foo b foo" → ?foo<CR>n → "a |foo b foo"
"|foo bar foo" → * → "foo bar |foo"
"foo bar |foo" → # → "|foo bar foo"
"|foo foobar foo" → * → "foo foobar |foo"
"|foo foobar foo" → g* → "foo |foobar foo"
"|foo foobar foo" → *n → "|foo foobar foo"
"|abc ABC" → /ABC<CR> → "abc |ABC"
"|abc ABC" → /\cabc<CR> → "abc |ABC"
"|abc ABC abc" → /abc<CR> → "abc |ABC abc" → set ignorecase
"|abc ABC abc" → /Abc<CR> → "|abc ABC abc" → set ignorecase smartcase
"|foo bar\nbaz" → d/baz<CR> → "|baz"
"x |foo bar\nbaz" → d/baz<CR> → "x| \nbaz"
"|a.b a-b" → /a.b<CR> → "a.b |a-b"
"|a.b a-b" → /a\.b<CR> → "|a.b a-b"
"|foo(bar) foo" → /(bar)<CR> → "foo|(bar) foo"
"|ab abb abbb" → /ab\+<CR> → "ab |abb abbb"
"|cat dog" → /cat\|dog<CR> → "cat |dog"
"|word sword word" → /\<word\><CR> → "word sword |word"
"|x1 x22 x333" → /x\d\{3}<CR> → "x1 x22 |x333"
"|foo" → /zzz<CR> → "|foo"
"|ab ab ab" → 2/ab<CR> → "ab ab |ab"
"|a\nb\na" → /a<CR> → "a\nb\n|a"
"|foo\nbar" → /bar<CR>ggn → "foo\n|bar"
"|a+b ab" → /a+b<CR> → "|a+b ab"
"|a{2} aa" → /a\{2}<CR> → "a{2} |aa"
"|foo bar" → /bar<CR>x → "foo |ar"
"|one two one" → /one<CR>cwx<Esc> → "one two |x"
"|日本語 日本" → /日本<CR> → "日本語 |日本"
"|ab\ncd ab" → /^cd<CR> → "ab\n|cd ab"
"|ab cd ab" → /ab$<CR> → "ab cd |ab"
"|xay xby" → /x[ab]y<CR> → "xay |xby"
"|xay xby" → /x\(a\|b\)y<CR>n → "|xay xby"
"foo |bar foo" → ?<CR> → "foo |bar foo"
"|abc abc" → /abc<CR>/<CR> → "|abc abc"
